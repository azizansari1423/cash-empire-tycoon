+-- Calls fn up to SAVE_RETRIES times with linear backoff.
+-- Returns true on first success, false if all attempts fail.
+local function withRetry(fn, label)
+	for attempt = 1, SAVE_RETRIES do
+		local ok, err = pcall(fn)
+		if ok then return true end
+		warn(string.format("[DataManager] %s failed (attempt %d/%d): %s",
