+-- ── Session locking ───────────────────────────────────────────────────────────
+-- Lock record: { jobId, timestamp, released }
+-- A lock is "live" (held by another server) when:
+--   - its jobId differs from ours
+--   - released is not true
+--   - its timestamp is within the last LOCK_TTL seconds
+-- Returning nil from an UpdateAsync callback is a no-op (existing value preserved).
+
+local function acquireLock(userId)
+	local acquired = false
+	local now      = os.time()
+	local ok, err = pcall(function()
+		LockStore:UpdateAsync(userId, function(current)
+			local liveLock = current ~= nil
+				and current.jobId    ~= JOB_ID
+				and current.released ~= true
+				and (now - (current.timestamp or 0)) < LOCK_TTL
+			if liveLock then
+				return nil  -- another server holds this player; abort the write
+			end
+			-- Available: no lock, our own lock, expired lock, or released lock
+			acquired = true
+			return { jobId = JOB_ID, timestamp = now, released = false }
+		end)
+	end)
+	if not ok then
+		warn("[DataManager] acquireLock error for " .. userId .. ": " .. tostring(err))
+		return false
+	end
+	return acquired
+end
+
+local function releaseLock(userId)
+	-- Clear activeLocks first so the refresh loop skips this userId immediately.
+	activeLocks[userId] = nil
+	pcall(function()
+		LockStore:UpdateAsync(userId, function(current)
+			if current and current.jobId == JOB_ID and not current.released then
+				return { jobId = JOB_ID, timestamp = os.time(), released = true }
+			end
+			return nil  -- not our lock; leave unchanged
+		end)
+	end)
+end
+
+local function refreshLock(userId)
+	pcall(function()
+		LockStore:UpdateAsync(userId, function(current)
+			if current and current.jobId == JOB_ID and not current.released then
+				return { jobId = JOB_ID, timestamp = os.time(), released = false }
+			end
+			return nil
+		end)
+	end)
+end
+
+-- ── Lock refresh loop ─────────────────────────────────────────────────────────
+task.spawn(function()
+	while true do
+		task.wait(LOCK_REFRESH)
+		for userId in pairs(activeLocks) do
+			refreshLock(userId)
+		end
+	end
+end)
